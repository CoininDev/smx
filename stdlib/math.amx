// Constants
pi = 3.141592653589793;
e = 2.718281828459045;
tau = 6.283185307179586;
phi = 1.618033988749895;


// Named operations
add = \x. \y. x + y;
sub = \x. \y. x - y;
mul = \x. \y. x * y;
div = \x. \y. x / y;
pow = \x. \y. x ** y;
mod = \x. \y. x % y;

// Basic Functions
abs = \x. x < 0 ? -x, x;
signum = \x. 
    x > 0 ? 1, 
    x < 0 ? -1, 
    0
;

max = \x. \y. x > y ? x, y;
min = \x. \y. x < y ? x, y;
clamp = \x. \low. \high. max x low : min high;

// Integer Parts
floor = \x. x % 1 < 0 ? (x - (x % 1) - 1), (x - (x % 1));
ceil = \x.  x % 1 > 0 ? (x - (x % 1) + 1), (x - (x % 1));
trunc = \x. x - (x % 1);
round = \x. (floor x) - x < 0.5 ? floor x, ceil x;

// Power and Roots
sqrt = \x. x ** (1/2);
cbrt = \x. x ** (1/3);

// Geometric
hypot = \x. \y. sqrt (x**2 + y**2);


// Conversions
_bin_to_dec__y = \self. \s ~string. \acc ~number. eval (
    s == "" ? 'acc,
    '(self self (tail s) (acc * 2 + (head s == "1" ? 1, 0)))
);

bin_to_dec = \s ~string. _bin_to_dec__y _bin_to_dec__y s 0;

_dec_to_bin__y = \self. \n ~number. eval (
    n == 0 ? '(""),
    '(self self (floor (n / 2)) + (n % 2 == 0 ? "0", "1"))
);

dec_to_bin = \n ~number. n == 0 ? "0", (_dec_to_bin__y _dec_to_bin__y n);

_hex_digit_to_dec = \d.
    d == "0" ? 0, d == "1" ? 1, d == "2" ? 2, d == "3" ? 3,
    d == "4" ? 4, d == "5" ? 5, d == "6" ? 6, d == "7" ? 7,
    d == "8" ? 8, d == "9" ? 9, d == "A" ? 10, d == "B" ? 11,
    d == "C" ? 12, d == "D" ? 13, d == "E" ? 14, d == "F" ? 15,
    d == "a" ? 10, d == "b" ? 11, d == "c" ? 12, d == "d" ? 13,
    d == "e" ? 14, d == "f" ? 15, 0;

_hex_to_dec__y = \self. \s ~string. \acc ~number. eval (
    s == "" ? 'acc,
    '(self self (tail s) (acc * 16 + (_hex_digit_to_dec (head s))))
);

hex_to_dec = \s ~string. _hex_to_dec__y _hex_to_dec__y s 0;

_dec_to_hex_digit = \n.
    n == 0 ? "0", n == 1 ? "1", n == 2 ? "2", n == 3 ? "3",
    n == 4 ? "4", n == 5 ? "5", n == 6 ? "6", n == 7 ? "7",
    n == 8 ? "8", n == 9 ? "9", n == 10 ? "A", n == 11 ? "B",
    n == 12 ? "C", n == 13 ? "D", n == 14 ? "E", n == 15 ? "F", "0";

_dec_to_hex__y = \self. \n ~number. eval (
    n == 0 ? '(""),
    '(self self (floor (n / 16)) + (_dec_to_hex_digit (n % 16)))
);

dec_to_hex = \n ~number. n == 0 ? "0", (_dec_to_hex__y _dec_to_hex__y n);


