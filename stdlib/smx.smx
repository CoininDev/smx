op left 2 (a :> b) = a : \_. b;


_smx_path @{IO} = IO.run "echo $SMXLIB_PATH": \x. x.stdout;
_import @{IO} = \(filename ~ string). 
  IO.import {file = _smx_path + filename; skip_underscored = true;};

_result @{IO} = 
     _import ("/test.amx") 
  :> _import ("/matchop.amx")
  :> _import ("/math.amx")
  :> _import ("/strings.amx")
  :> _import ("/lists.amx")
  :> _import ("/logic.amx");
