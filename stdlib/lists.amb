_length__y = \self. \(l ~ []). \(acc ~ number). eval (
    l == nil ? 'acc,
    '(self self (tail l) (acc + 1))
);

_take__y = \self. \(n ~ number). \(l ~ []). \(acc ~ []). eval (
    n == 0 ? 'acc,
    (l == nil ? 'acc,
    '(self self (n - 1) (tail l) (head l, acc)))
);

_drop__y = \self. \(n ~ number). \(l ~ []). eval (
    n == 0 ? 'l,
    (l == nil ? 'l,
    '(self self (n - 1) (tail l)))
);

_map__y = \self. \(f ~ fn). \(l ~ []). \(acc ~ []). eval (
    l == nil ? 'acc,
    '(self self f (tail l) (f (head l), acc))
);

_filter__y = \self. \(f ~ fn). \(l ~ []). \(acc ~ []). eval (
    l == nil ? 'acc,
    (f (head l) ? '(self self f (tail l) (head l, acc)),
    '(self self f (tail l) acc))
);

_reduce__y = \self. \(f ~ fn). \(l ~ []). \(acc). eval (
    l == nil ? 'acc,
    '(self self f (tail l) ((f acc) (head l)))
);

_zip__y = \self. \(l1 ~ []). \(l2 ~ []). \(acc ~ []). eval (
    l1 == nil ? 'acc,
    (l2 == nil ? 'acc,
    '(self self (tail l1) (tail l2) ((head l1, head l2), acc)))
);

_unzip__y = \self. \(l ~ []). \(acc1 ~ []). \(acc2 ~ []). eval (
    l == nil ? '(acc1, acc2),
    '(self self (tail l) ((l: head: head), acc1) ((l: head: tail), acc2))
);

_reverse__y = \self. \(l ~ []). \(acc ~ []). eval (
    l == nil ? 'acc,
    '(self self (tail l) (head l, acc))
);

lists = {
    length = \(l ~ []). _length__y _length__y l 0;
    reverse = \(l ~ []). _reverse__y _reverse__y l nil;

    take = \(n ~ number). \(l ~ []). 
        _take__y _take__y n l nil
        : reverse;
    
    drop = \(n ~ number). \(l ~ []). _drop__y _drop__y n l;
    
    map = \(f ~ fn). \(l ~ []). 
        _map__y _map__y f l nil
        : reverse;
    
    filter = \(f ~ fn). \(l ~ []). 
        _filter__y _filter__y f l nil
        : reverse;
    
    reduce = \(f ~ fn). \(l ~ []). \(init). 
        _reduce__y _reduce__y f l init;
    
    zip = \(l1 ~ []). \(l2 ~ []). 
        _zip__y _zip__y l1 l2 nil
        : reverse;
    
    unzip = \(l ~ []). 
        _unzip__y _unzip__y l nil nil
        : \(a1, a2). (reverse a1, reverse a2);
};