_length_y = \self. \(l ~ []). \(acc ~ number).
    if l == nil 
    then acc
    else self self (tail l) (acc + 1)
;

_take_y = \self. \(n ~ number). \(l ~ []).
    if      n == 0    then nil
    else if l == nil  then nil
    else head l, self self (n - 1) (tail l)
;

_drop_y = \self. \(n ~ number). \(l ~ []).
    if      n == 0  then l 
    else if l == nil then l   
    else self self (n - 1) (tail l)
;

_map_y = \self. \(f ~ fn). \(l ~ []). 
    if l == nil 
    then nil
    else f (head l), self self f (tail l)
;

_filter_y = \self. \(f ~ fn). \(l ~ []). 
    if l == nil 
    then nil 
    else if f (head l) 
    then head l, self self f (tail l)
    else self self f (tail l)
;

_reduce_y = \self. \(f ~ fn). \acc. \(l ~ []).
    if l == nil 
    then acc
    else self self f (tail l) ((f acc) (head l))
;

_zip_y = \self. \(l1 ~ []). \(l2 ~ []).
    if l1 == nil then nil
    else if l2 == nil then nil
    else (head l1, head l2), self self (tail l1) (tail l2)
;

_unzip_y = \self. \(l ~ []).
    if l == nil then nil
    else let rest = self self (tail l); in
        ((l:head:head), head rest),
        ((l:head:tail), tail rest)
;

_enumerate_y = \self. \acc ~ number. \l ~ [].
    if l == nil then nil
    else (head l, acc), self self (acc + 1) (tail l)
;

_reverse_y = \self. \l ~ []. \acc ~ []. 
    if l == nil then acc
    else self self (tail l) (head l, acc)
;

_chunks_of_y = \self. \n ~ number. \l ~ []. 
let
    take = _take_y _take_y;
    drop = _drop_y _drop_y;
in
    if l == nil then nil
    else take n l, self self n (drop n l)
;

_unnilize_y = \self. \(l ~ []).
    if l == nil      then nil
    else if tail l == nil then head l
    else head l, self self (tail l)
;

_nilize_y = \self. \l.
    if l == nil then nil
    else if try (tail, l) == {err = true;} then l, nil
    else head l, self self (tail l)
;

_join_y = \self. \l1. \l2.
    if      l1 == nil then l2
    else if l2 == nil then l1
    else head l1, self self (tail l1) l2
;

_elaborate_y = \self. \quantity ~ number. \last_value. \f ~ fn.
    if quantity == 0 then nil
    else last_value, self self (quantity - 1) (f last_value) f
;

lists = {
    length = \(l ~ []). _length_y _length_y l 0;
    reverse = \(l ~ []). _reverse_y _reverse_y l nil;
    unnilize = _unnilize_y _unnilize_y;
    nilize = _nilize_y _nilize_y;
    take = _take_y _take_y;
    drop = _drop_y _drop_y;
    join = _join_y _join_y;
    map = _map_y _map_y;
    filter = _filter_y _filter_y;
    reduce = _reduce_y _reduce_y;
    zip = _zip_y _zip_y;
    unzip = _unzip_y _unzip_y;
    chunks_of = _chunks_of_y _chunks_of_y;
    elaborate = _elaborate_y _elaborate_y;
    enumerate = _enumerate_y _enumerate_y 0;
    push = \l ~ []. \x. (unnilize l), x, nil;
};