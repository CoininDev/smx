op left 2 (a :> b) = a : \_. b;

_import @{IO} = \(filename ~ string). IO.import {file = filename; skip_underscored = true;};

_home_dir @{IO} = IO.run "echo $HOME" : \x. x.stdout + "/";
_std_path @{IO} = _home_dir : \x. x + ".local/lib/smx/";

_result @{IO} = 
     _import (_std_path + "test.amb") 
  :> _import (_std_path + "matchop.amb");
