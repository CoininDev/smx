f1 = \x ~ number. x + 2;
r1 = f1 10;
println "result 1 (\\x ~ number. x + 2) 10 = " (format r1);

f2 = \a, b. a + b;
r2 = f2 (1, 2);
println "result 2 (\\a, b. a + b) (1, 2) = " (format r2);

data = { a = { b = 10 } };
f3 = \(x.a.b) ~ number. x.a.b + 1;
r3 = f3 data;
println "result 3 (\\(x.a.b) ~ number. x.a.b + 1) ... = " (format r3);
