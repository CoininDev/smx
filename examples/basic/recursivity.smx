fact = \n. eval (
    n == 0 ? 
      '1, 
      '(n * __self(n - 1))
);

//if you have more than 1 curried parameter, the __self refers to the most inner function
//so you need to pass the self parameter explicitly
fact2_y @{IO} = \self. \passes. \n. eval (
    n == 0 ? 
      '1, 
      '(n * (self self (passes + "": IO.print : \_. passes + 1) (n - 1)))
);

// what a usually do is make a wrapper that handle the self parameter
fact2 = fact2_y fact2_y;

result = fact2 0 5;