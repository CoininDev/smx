op right 2.7 (a -> b) = a, b;

__match_y = \self. \val. \b.
{
    f0 = \((pat ~ pattern, expr ~ frozen), rest). eval (
        zip_env(pat, val) != nil ?
            '(zip_env(pat, val) :: expr),
            '(self self rest)
    );

    f1 = \(pat ~ pattern, expr ~ frozen). eval (
        zip_env(pat, val) != nil ?
            '(zip_env(pat, val) :: expr),
            '{match_failed = 1;}
    );
} :: '(
    try (f0, b) != nil ? f0 b,
    try (f1, b) != nil ? f1 b, 
    nil
);

op right 2 (a ?> b) = __match_y __match_y a b;

result @{IO} = 
  (1, "example", 3) ?> (

  #('(a ~ string), '(b ~ number))     -> '(b + 42),
  #('(a ~ number), 'b, '(c ~ number)) -> '(IO.print b: \_. a + b),
  #'(x ~ number)                      -> '(x + 14),
  #'_                                 -> '0
);
