import @ { IO } = \x. (IO.import x);
print @ { IO } = \x. (IO.print x);
_ = print "Importing math...";
_ = import { file = "stdlib/math.amx"; skip_underscored = false; };
_ = print "Math imported.";

// Test constants
_ = print "Testing constants...";
test_pi = abs (pi - 3.14159) < 0.001;
test_e = abs (e - 2.71828) < 0.001;

// Test basic functions
_ = print "Testing basics...";
test_abs = (abs (-5) == 5) && (abs 5 == 5);
test_signum = (signum (-10) == -1) && (signum 0 == 0) && (signum 10 == 1);
test_max = (max 10 20 == 20);
test_min = (min 10 20 == 10);

// Test integer parts
_ = print "Testing integer parts...";
test_floor = (floor 1.5 == 1) && (floor (-1.5) == -2);
test_ceil = (ceil 1.1 == 2) && (ceil (-1.1) == -1);
test_trunc = (trunc 1.9 == 1) && (trunc (-1.9) == -1);
test_round = (round 1.4 == 1) && (round 1.6 == 2);

// Test Power and Roots
_ = print "Testing power and roots...";
test_pow = 2 ** 3 == 8;
test_sqrt = sqrt 16 == 4;
test_cbrt = abs (cbrt 27 - 3) < 0.001;

// Test Modulo
_ = print "Testing modulo...";
test_mod = (10 % 3 == 1) && ((-1.5) % 1 == -0.5);

_ = print "Finalizing...";
result = {
    pi = test_pi;
    e = test_e;
    abs = test_abs;
    signum = test_signum;
    max = test_max;
    min = test_min;
    floor = test_floor;
    ceil = test_ceil;
    trunc = test_trunc;
    round = test_round;
    pow = test_pow;
    sqrt = test_sqrt;
    cbrt = test_cbrt;
    mod = test_mod;
};
